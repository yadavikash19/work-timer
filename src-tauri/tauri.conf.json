{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Work Timer",
  "version": "2.0.0",
  "identifier": "app.worktimer.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "app",
      "dmg"
    ],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEExNURBQUEyQTFFNzk0MDYKUldRR2xPZWhvcXBkb1lkMVRURW1PMVZNN1BnOUw5bXJTd09nbXdwZ2thRHMyVElLd2xyb2pFeEQK",
      "endpoints": [
        "https://github.com/yadavikash19/work-timer/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}